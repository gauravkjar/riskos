# Postgres connection string. Vercel Postgres / Neon integrations set
# POSTGRES_URL automatically when linked to a project; if you provisioned a
# Neon database yourself its dashboard may instead give you DATABASE_URL —
# either name works (lib/db/pg.ts checks POSTGRES_URL first, then falls back
# to DATABASE_URL). See README-DB.md for local setup options.
POSTGRES_URL=postgres://user:password@host:5432/dbname

# HMAC secret used to sign session tokens (lib/auth/session.ts). Required in
# production — the app falls back to an insecure hardcoded dev secret if this
# is unset, which is only acceptable for local development.
SESSION_SECRET=replace-with-a-long-random-string
